# All lab settings in one place. Read by the bash scripts and by bin/health.py.

NAME=lab                           # container name
IMAGE=images:ubuntu/24.04          # public image, downloaded once during setup
IMAGE_ALIAS=lab-ubuntu-24.04       # local copy of it, so the lab can be rebuilt offline
BRIDGE=labbr0                      # dedicated lab bridge (never Incus's default incusbr0)
BRIDGE_ADDRESS=10.123.0.1/24       # host address on the lab bridge; the bridge does NAT
CONTAINER_IP=10.123.0.10           # fixed container address, so repeat runs look the same

CPU_LIMIT=200ms/100ms              # 200 ms of CPU every 100 ms = 2 CPUs   (becomes cgroup cpu.max)
MEMORY_LIMIT=1GiB                  #                                      (becomes cgroup memory.max)
CPU_PIN=                           # optional: host CPUs for the container, e.g. 5-9 (becomes cpuset.cpus)

PORT=8080                          # app port inside the container
WORK=60000                         # loop iterations per /work request (a few ms of CPU)

CLIENTS=1                          # load: clients sending requests back to back (fixed concurrency)
DURATION=20                        # load: seconds per fault phase

FAULT_CPU_LIMIT=50ms/100ms         # CPU fault: 0.5 CPU
FAULT_NETEM="delay 40ms"           # network fault: tc netem settings (a fixed, bounded delay)

BASELINE=reports/baseline.json     # baseline profile for the drift check (make baseline)
HEALTH_INTERVAL=5                  # health: seconds of sampling (counters read at start and end)
HEALTH_TIMEOUT=20                  # health: runtime limit for the whole command, seconds
LOG_WINDOW_MIN=10                  # health: kernel log window, minutes back from now

LOAD_WARN_PER_CPU=1.0              # host: 1-minute load per CPU above this -> WARN
MEM_AVAILABLE_WARN_PCT=10          # host: available memory below this % -> WARN
MEM_AVAILABLE_FAIL_PCT=5           #                                     -> FAIL
DISK_WARN_PCT=85                   # host: root filesystem used above this % -> WARN
DISK_FAIL_PCT=95                   #                                         -> FAIL
THROTTLE_WARN_PCT=20               # container: % of CPU periods throttled -> WARN
THROTTLE_FAIL_PCT=60               #                                        -> FAIL
MEMORY_WARN_PCT=80                 # container: memory used, % of the limit -> WARN
MEMORY_FAIL_PCT=95                 #                                         -> FAIL
SLOW_P99_MS=100                    # app: p99 above this -> WARN
